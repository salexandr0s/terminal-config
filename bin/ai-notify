#!/usr/bin/env bash
set -euo pipefail

tool="${1:-ai}"
event="${2:-done}"
duration_seconds="${3:-}"
sound="${AI_NOTIFY_SOUND:-/System/Library/Sounds/Glass.aiff}"
cooldown_seconds="${AI_NOTIFY_COOLDOWN_SECONDS:-15}"
min_duration_seconds="${AI_NOTIFY_MIN_SECONDS:-15}"
always_notify="${AI_NOTIFY_ALWAYS:-0}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ai-notify"
state_file="$cache_dir/last-event"

# Compute duration from session start if not provided as argument
if [ -z "$duration_seconds" ] && [ -n "${AI_SESSION_START_TS:-}" ]; then
  duration_seconds=$(( $(date +%s) - AI_SESSION_START_TS ))
fi

is_integer() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

format_duration() {
  local s="${1:-0}" h m
  h=$((s / 3600))
  m=$(((s % 3600) / 60))
  s=$((s % 60))
  if [ "$h" -gt 0 ]; then printf '%dh%02dm' "$h" "$m"
  elif [ "$m" -gt 0 ]; then printf '%dm%02ds' "$m" "$s"
  else printf '%ds' "$s"
  fi
}

should_notify() {
  local now last_epoch

  if [ "$always_notify" = "1" ]; then
    return 0
  fi

  if is_integer "$duration_seconds" && is_integer "$min_duration_seconds" && [ "$duration_seconds" -lt "$min_duration_seconds" ]; then
    return 1
  fi

  if ! is_integer "$cooldown_seconds" || [ "$cooldown_seconds" -le 0 ]; then
    return 0
  fi

  mkdir -p "$cache_dir"
  now=$(date +%s)

  if [ -f "$state_file" ]; then
    last_epoch=$(cut -d' ' -f1 "$state_file" 2>/dev/null || printf '0')
    if is_integer "$last_epoch" && [ $((now - last_epoch)) -lt "$cooldown_seconds" ]; then
      return 1
    fi
  fi

  printf '%s %s %s %s\n' "$now" "$tool" "$event" "${AI_HOUSE_MODE:-normal}" >"$state_file"
  return 0
}

if ! should_notify; then
  exit 0
fi

# Duration tier: <30s suppressed (handled by min_duration_seconds default),
# 30s-5m: sound only, >5m: sound + optional ntfy push
ntfy_topic="${AI_NOTIFY_NTFY_TOPIC:-}"

# Play sound
played_sound=0
case "$(uname -s)" in
  Darwin)
    if command -v afplay >/dev/null 2>&1 && [ -f "$sound" ]; then
      /usr/bin/afplay "$sound" >/dev/null 2>&1 || true
      played_sound=1
    fi
    ;;
esac

if [ "$played_sound" -eq 0 ]; then
  printf '\a' >/dev/tty 2>/dev/null || printf '\a' || true
fi

# Push notification for long tasks (>5 minutes)
if [ -n "$ntfy_topic" ] && is_integer "$duration_seconds" && [ "$duration_seconds" -gt 300 ]; then
  summary="${tool} ${event} ($(format_duration "$duration_seconds"))"
  curl -s --max-time 10 -d "$summary" "https://ntfy.sh/$ntfy_topic" >/dev/null 2>&1 &
fi
