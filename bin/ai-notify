#!/usr/bin/env bash
set -euo pipefail

tool="${1:-ai}"
event="${2:-done}"
duration_seconds="${3:-}"
sound="${AI_NOTIFY_SOUND:-/System/Library/Sounds/Glass.aiff}"
cooldown_seconds="${AI_NOTIFY_COOLDOWN_SECONDS:-15}"
min_duration_seconds="${AI_NOTIFY_MIN_SECONDS:-15}"
always_notify="${AI_NOTIFY_ALWAYS:-0}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ai-notify"
state_file="$cache_dir/last-event"

is_integer() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

should_notify() {
  local now last_epoch

  if [ "$always_notify" = "1" ]; then
    return 0
  fi

  if is_integer "$duration_seconds" && is_integer "$min_duration_seconds" && [ "$duration_seconds" -lt "$min_duration_seconds" ]; then
    return 1
  fi

  if ! is_integer "$cooldown_seconds" || [ "$cooldown_seconds" -le 0 ]; then
    return 0
  fi

  mkdir -p "$cache_dir"
  now=$(date +%s)

  if [ -f "$state_file" ]; then
    last_epoch=$(cut -d' ' -f1 "$state_file" 2>/dev/null || printf '0')
    if is_integer "$last_epoch" && [ $((now - last_epoch)) -lt "$cooldown_seconds" ]; then
      return 1
    fi
  fi

  printf '%s %s %s %s\n' "$now" "$tool" "$event" "${AI_HOUSE_MODE:-normal}" >"$state_file"
  return 0
}

if ! should_notify; then
  exit 0
fi

case "$(uname -s)" in
  Darwin)
    if command -v afplay >/dev/null 2>&1 && [ -f "$sound" ]; then
      /usr/bin/afplay "$sound" >/dev/null 2>&1 || true
      exit 0
    fi
    ;;
esac

printf '\a' >/dev/tty 2>/dev/null || printf '\a' || true
printf '%s:%s\n' "$tool" "$event" >/dev/null 2>&1 || true
